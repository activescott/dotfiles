#!/usr/bin/env sh
THISDIR=$(cd $(dirname "$0"); pwd) #this script's directory

DATE=`date "+%Y-%m-%dT%H_%M_%S"`

cpsafe() {
 SRC=$1
 DST=$2
 if [ -f "$SRC" ]; then 
  [ -L "$DST" ] && echo "removing link $DST" && rm "$DST" #rm if link
  [ -f "$DST" ] && mv -v "$DST" "$DST.old-$DATE" #mv to "just in case" file
  ln -vs "$SRC" "$DST"
 else
  printf "\n *WARNING*: $SRC doesn't exist!\n\n"
  return 1
 fi
}

cpsafe_dir() {
 SRCDIR=$1
 DSTDIR=$2
 
[ -d "$DSTDIR" ] || mkdir -p "$DSTDIR"
for filepath in $SRCDIR/*; do
    filename=`basename $filepath`
    cpsafe "$filepath" "$DSTDIR/$filename"
done
 
}

DOTFILESDIR=$(dirname $THISDIR)

# ~/bin
echo "\n########## Copying $DOTFILESDIR/bin files... ##########"
[ -d "$HOME/bin" ] || mkdir -p "$HOME/bin"
for filepath in $DOTFILESDIR/bin/*; do
    filename=`basename $filepath`
    #echo "hi $filepath -> $filename"
    cpsafe "$filepath" ~/bin/$filename
done 

# ~/lib
echo "\n########## Copying $DOTFILESDIR/lib files... ##########"
[ -d "$HOME/lib" ] || mkdir -p "$HOME/lib"
for filepath in $DOTFILESDIR/lib/*; do
    filename=`basename $filepath`
    #echo "hi $filepath -> $filename"
    cpsafe "$filepath" ~/lib/$filename
done

# Midnight Commander:
echo "\n########## Copying Midnight Commander files... ##########"
cpsafe_dir "$DOTFILESDIR/.config/mc" ~/.config/mc

echo "\n########## Copying 1Password config files... ##########"
cpsafe_dir "$DOTFILESDIR/.config/1Password/ssh" ~/.config/1Password/ssh

echo "\n########## Copying k9s config files... ##########"
# k9s uses ~/Library/Application Support/k9s/ on macOS (not ~/.config/k9s/)
cpsafe_dir "$DOTFILESDIR/.config/k9s" "$HOME/Library/Application Support/k9s"

# misc apps, etc.
echo "\n########## Copying misc files... ##########"
cpsafe "$DOTFILESDIR/.bash_secrets" ~/.bash_secrets

# source common .<shell>rc stuff for bash and zsh:
cpsafe "$DOTFILESDIR/.shrc" ~/.shrc

# bash:
cpsafe "$DOTFILESDIR/.bashrc" ~/.bashrc
cpsafe "$DOTFILESDIR/.bash_profile" ~/.bash_profile
cpsafe "$DOTFILESDIR/.inputrc" ~/.inputrc

# tmux:
cpsafe "$DOTFILESDIR/.tmux.conf" ~/.tmux.conf

# zsh: https://linuxhint.com/configure-setup-zshrc-zsh/
cpsafe "$DOTFILESDIR/.zshrc" ~/.zshrc
cpsafe "$DOTFILESDIR/.zprofile" ~/.zprofile


echo "\n########## Copying SSH & git config files... ##########"
[ -d "$HOME/.ssh/config" ] || mkdir -p "$HOME/.ssh/config"
cpsafe "$DOTFILESDIR/.ssh/config" ~/.ssh/config

cpsafe "$DOTFILESDIR/.config/1Password/ssh/agent.toml" ~/.config/1Password/ssh/agent.toml


echo "\n########## Copying git config files... ##########"
cpsafe "$DOTFILESDIR/.gitconfig" ~/.gitconfig
cpsafe "$DOTFILESDIR/.ssh/authorized_keys" ~/.ssh/authorized_keys # for general ssh authorized access
cpsafe "$DOTFILESDIR/.ssh/allowed_signers" ~/.ssh/allowed_signers # for git's SSH commit verification
cpsafe "$DOTFILESDIR/.gitconfig.commit-signing-1p.include" ~/.gitconfig.commit-signing-1p.include
cpsafe "$DOTFILESDIR/.gitconfig.commit-signing-local.include" ~/.gitconfig.commit-signing-local.include
cpsafe "$DOTFILESDIR/.gitconfig.commit-signing-onlykey.include" ~/.gitconfig.commit-signing-onlykey.include

# Symlinks the repo-managed parts of the cross-harness ~/.agents/ directory.
# opencode and other agent-compatible tools auto-discover AGENTS.md, skills,
# and rules here; Claude Code does NOT, so setup_claude_dir also creates
# per-profile aliases under ~/.claude/.
setup_agents_dir() {
 agents_dir="$HOME/.agents"
 # Whole-dir symlinks for skills and rules (canonical sources in the dotfiles
 # repo). Per-skill/per-rule file aliasing is overkill since these are
 # fully repo-managed and the dotfiles repo is the only legitimate writer.
 for sub in skills rules; do
   dst="$agents_dir/$sub"
   [ -L "$dst" ] && echo "removing link $dst" && rm "$dst"
   [ -d "$dst" ] && rm -rf "$dst"
   ln -vs "$DOTFILESDIR/.agents/$sub" "$dst"
 done
 # AGENTS.md: single-file symlink.
 cpsafe "$DOTFILESDIR/.agents/AGENTS.md" "$agents_dir/AGENTS.md"
}

# Symlinks the repo-managed parts of a Claude Code config directory. Called once
# for the default ~/.claude and once per additional account profile. A profile is
# selected at runtime with CLAUDE_CONFIG_DIR (see bin/claude-work); Claude Code
# then keeps .claude.json, .credentials.json, projects/ and history in that
# directory, so each profile authenticates to its own Claude subscription while
# reading the same instructions, settings, rules and skills from this repo.
#
# Skills and rules live canonically under ~/.agents/ (set up by setup_agents_dir).
# The whole ~/.claude/skills and ~/.claude/rules directories are symlinked to
# their ~/.agents/ counterparts so each claude profile sees the canonical set —
# Claude Code only looks at .claude/, not .agents/. AGENTS.md is aliased the
# same way (single-file symlink).
setup_claude_dir() {
 claude_dir=$1
 [ -d "$claude_dir" ] || mkdir -p "$claude_dir"
 cpsafe "$DOTFILESDIR/.claude/CLAUDE.md" "$claude_dir/CLAUDE.md"
 cpsafe "$HOME/.agents/AGENTS.md" "$claude_dir/AGENTS.md"
 cpsafe "$DOTFILESDIR/.claude/settings.json" "$claude_dir/settings.json"
 [ -d "$claude_dir/hooks" ] || mkdir -p "$claude_dir/hooks"
 cpsafe "$DOTFILESDIR/.claude/hooks/confirm-before-run.sh" "$claude_dir/hooks/confirm-before-run.sh"
 # Replace ~/.claude/skills and ~/.claude/rules with whole-dir symlinks to
 # ~/.agents/skills and ~/.agents/rules (set up by setup_agents_dir).
 for sub in skills rules; do
   dst="$claude_dir/$sub"
   [ -L "$dst" ] && echo "removing link $dst" && rm "$dst"
   [ -d "$dst" ] && rm -rf "$dst"
   ln -vs "$HOME/.agents/$sub" "$dst"
 done
 # Slash commands are a Claude Code feature with no opencode/agent-agnostic
 # equivalent, so they stay under .claude/ rather than ~/.agents/. Whole-dir
 # symlink for the same reason as skills and rules: repo-managed, single writer.
 dst="$claude_dir/commands"
 [ -L "$dst" ] && echo "removing link $dst" && rm "$dst"
 [ -d "$dst" ] && rm -rf "$dst"
 ln -vs "$DOTFILESDIR/.claude/commands" "$dst"
 # Non-default profiles share the downloaded plugin cache with ~/.claude instead
 # of re-downloading it. Which plugins are enabled still comes from settings.json.
 if [ "$claude_dir" != "$HOME/.claude" ]; then
   [ -d "$HOME/.claude/plugins" ] || mkdir -p "$HOME/.claude/plugins"
   dst="$claude_dir/plugins"
   [ -L "$dst" ] && echo "removing link $dst" && rm "$dst"
   [ -d "$dst" ] && mv -v "$dst" "$dst.old-$DATE"
   ln -vs "$HOME/.claude/plugins" "$dst"
 fi
}

echo "\n########## Copying ~/.agents/skills/... ##########"
setup_agents_dir

echo "\n########## Copying Claude config files... ##########"
setup_claude_dir "$HOME/.claude"

# "work" profile: separate Claude account/credentials so a client's subscription is
# billed for their work. Launch it with ~/bin/claude-work. First run prompts for an
# OAuth login because ~/.claude-work has no credentials yet.
# Reference: https://docs.runmaestro.ai/multi-claude (its ~/.claude/.claude.json
# shuffle is obsolete; CLAUDE_CONFIG_DIR alone redirects state and credentials).
echo "\n########## Setting up Claude 'work' profile in ~/.claude-work... ##########"
setup_claude_dir "$HOME/.claude-work"

# Symlinks the repo-managed parts of an opencode config directory. opencode reads
# ~/.config/opencode/opencode.json(c) for global config, AGENTS.md for global rules,
# and plugins/ for local TypeScript plugins. Skills are NOT symlinked here — opencode
# auto-discovers ~/.agents/skills/* (set up by setup_agents_dir) as well as
# ~/.claude/skills/* (Claude-compat fallback), and caveman is installed once per
# machine via the skill installer.
#
# Source files live under .config/opencode/ (not .opencode/) so the dotfiles repo
# itself isn't treated as an opencode project — opencode walks up from cwd looking
# for .opencode/ and would otherwise load the plugin twice (once globally, once as
# a project-level plugin).
setup_opencode_dir() {
 ocdir="$HOME/.config/opencode"
 [ -d "$ocdir" ] || mkdir -p "$ocdir"
 [ -d "$ocdir/plugins" ] || mkdir -p "$ocdir/plugins"
 cpsafe "$DOTFILESDIR/.config/opencode/opencode.jsonc" "$ocdir/opencode.jsonc"
 cpsafe "$DOTFILESDIR/.config/opencode/plugins/confirm-before-run.ts" "$ocdir/plugins/confirm-before-run.ts"
 cpsafe "$DOTFILESDIR/.config/opencode/plugins/package.json" "$ocdir/plugins/package.json"
 # Note: we don't symlink ~/.config/opencode/AGENTS.md. The opencode config's
 # `instructions` array points directly at ~/.agents/AGENTS.md instead, so no
 # per-opencode symlink is needed.
 echo "Reminder (one-time):  npx skills add JuliusBrussee/caveman --skill '*' -a opencode --yes"
 echo "Reminder: ensure 'mcp-grafana' is on PATH (brew/npm/manual) for the grafana MCP server."
}
echo "\n########## Setting up opencode config in ~/.config/opencode/... ##########"
setup_opencode_dir

echo "\n########## Copying misc config files... ##########"
[ -f "$DOTFILESDIR/.shrc-rsos" ] && cpsafe "$DOTFILESDIR/.shrc-rsos" ~/.shrc-rsos

# Install xterm-ghostty terminfo for root so `sudo nano` etc. work under Ghostty.
# Ghostty installs its terminfo to the user's ~/.terminfo, but root doesn't see it,
# causing "'xterm-ghostty': unknown terminal type." Copy the user's entry into the
# system terminfo db via tic. Skipped if user has no xterm-ghostty entry (not Ghostty).
echo "\n########## Installing xterm-ghostty terminfo for root... ##########"
if infocmp -x xterm-ghostty >/dev/null 2>&1; then
  infocmp -x xterm-ghostty | sudo tic -x - \
    && echo "installed xterm-ghostty terminfo for root" \
    || echo "WARNING: failed to install xterm-ghostty terminfo for root"
else
  echo "user has no xterm-ghostty terminfo entry; skipping (not running Ghostty?)"
fi

# macOS Terminal.app: enable "Use Option as Meta key" so Option+Backspace sends
# the escape sequence that .zshrc and .inputrc bind to backward-kill-word.
# Without this, Option+Backspace types a special character instead of deleting a word.
if [ "$(uname)" = "Darwin" ]; then
  current_profile=$(defaults read com.apple.Terminal "Default Window Settings" 2>/dev/null || echo "Basic")
  /usr/libexec/PlistBuddy -c "Set 'Window Settings:${current_profile}:useOptionAsMetaKey' true" ~/Library/Preferences/com.apple.Terminal.plist 2>/dev/null \
    && echo "Enabled 'Use Option as Meta key' for Terminal profile: ${current_profile}" \
    || echo "Note: Manually enable 'Use Option as Meta key' in Terminal > Preferences > Profiles > Keyboard"
fi
